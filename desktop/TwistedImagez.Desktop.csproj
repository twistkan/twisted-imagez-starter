<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <EmbeddedResource Include="..\app\index.html" LogicalName="TwistedImagez.Desktop.Embedded.app.index.html" />
    <EmbeddedResource Include="..\app\app.js" LogicalName="TwistedImagez.Desktop.Embedded.app.app.js" />
    <EmbeddedResource Include="..\app\styles.css" LogicalName="TwistedImagez.Desktop.Embedded.app.styles.css" />
    <EmbeddedResource Include="..\server.ps1" LogicalName="TwistedImagez.Desktop.Embedded.server.ps1" />
    <EmbeddedResource Include="..\sample-data\twisted-imagez-data.json" LogicalName="TwistedImagez.Desktop.Embedded.data.twisted-imagez-data.json" />
  </ItemGroup>
</Project>
